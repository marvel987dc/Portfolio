---
const projects = [
  { title: "Blackjack JS", description: "Blackjack game made with HTML, CSS, and JavaScript.", languages: "HTML · CSS · JavaScript", repo: "JS-Blackjack", mark: "♠", tone: "blue" },
  { title: "API News", description: "News app that fetches data from the News API.", languages: "HTML · CSS · JavaScript", repo: "API-NEWS", mark: "NEWS", tone: "cyan" },
  { title: "Python Slot Machine", description: "Slot machine game made with Python.", languages: "Python", repo: "Python-slot-machine", mark: "777", tone: "violet" },
  { title: "JavaFX Form Database", description: "Form that saves data to a database made with JavaFX.", languages: "Java · JavaFX", repo: "Database_form-", mark: "▤", tone: "cyan" },
  { title: "Trivia Test", description: "Trivia game made with React.", languages: "HTML · CSS · React", repo: "trivia_test-", mark: "?", tone: "blue" },
  { title: "AuthenticAuth", description: "Check the validations of your certificates by using blockchain (Powered by AI).", languages: "Go · React · Tailwind · HTML", repo: "AuthenticAuth", mark: "◈", tone: "violet" },
];
---
<section class="section projects-section" id="projects">
  <div class="container">
    <div class="section-heading projects-heading"><div><p class="eyebrow">A few things I’ve made</p><h2 class="section-title">Featured <span>projects</span></h2></div><p class="section-copy">Small experiments and practical builds that helped me learn by doing.</p></div>
    <div class="project-grid">{projects.map((project, index) => <article class="project-card">
      <div class={`project-cover ${project.tone}`} aria-hidden="true"><span class="cover-index">0{index + 1}</span><span class="cover-mark">{project.mark}</span><span class="cover-code">{project.languages.split(" · ").join(" / ")}</span><span class="cover-orb"></span></div>
      <div class="project-info"><p class="project-kicker">{project.languages}</p><h3>{project.title}</h3><p class="project-description">{project.description}</p><a href={`https://github.com/marvel987dc/${project.repo}`} target="_blank" rel="noopener noreferrer" class="project-link">View on GitHub <span aria-hidden="true">↗</span></a></div>
    </article>)}</div>
  </div>
</section>
<style>
  .projects-section { border-block: 1px solid rgba(255,255,255,.045); background: rgba(255,255,255,.012); }
  .projects-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .projects-heading .section-copy { max-width: 360px; margin-bottom: 2px; }
  .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .project-card { overflow: hidden; border: 1px solid var(--line); border-radius: 17px; background: #131c2b; transition: transform .24s ease, border-color .24s ease, box-shadow .24s ease; }
  .project-card:hover { transform: translateY(-5px); border-color: rgba(105,120,209,.4); box-shadow: 0 18px 48px rgba(0,0,0,.19); }
  .project-cover { position: relative; height: 180px; display: grid; place-items: center; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--line); }
  .project-cover::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .7; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 26px 26px; mask-image: linear-gradient(transparent, #000 35%, #000); }
  .project-cover.blue { background: radial-gradient(ellipse at 48% 110%, rgba(105,120,209,.31), transparent 58%), #121a2a; }
  .project-cover.cyan { background: radial-gradient(ellipse at 48% 110%, rgba(19,173,199,.25), transparent 58%), #121a2a; }
  .project-cover.violet { background: radial-gradient(ellipse at 48% 110%, rgba(148,93,214,.29), transparent 58%), #121a2a; }
  .cover-index { position: absolute; top: 15px; left: 17px; color: rgba(231,237,251,.42); font: .75rem ui-monospace, monospace; }
  .cover-mark { color: #dce6fb; font-size: 4.6rem; font-weight: 700; letter-spacing: -.08em; text-shadow: 0 0 32px rgba(19,173,199,.4); }
  .cyan .cover-mark { color: #8adce8; font-size: 2.8rem; letter-spacing: .14em; }
  .violet .cover-mark { color: #d0b2fa; }
  .cover-code { position: absolute; bottom: 14px; left: 17px; color: #8795ae; font: .62rem ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
  .cover-orb { position: absolute; top: -35px; right: -20px; width: 126px; height: 126px; border: 1px solid rgba(255,255,255,.1); border-radius: 50%; box-shadow: 0 0 0 20px rgba(255,255,255,.018), 0 0 0 40px rgba(255,255,255,.012); }
  .project-info { display: flex; min-height: 204px; flex-direction: column; align-items: flex-start; padding: 20px; }
  .project-kicker { margin-bottom: 11px; color: var(--cyan); font-size: .68rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .project-info h3 { margin-bottom: 9px; font-size: 1.13rem; letter-spacing: -.02em; }
  .project-description { min-height: 48px; margin-bottom: 17px; color: var(--muted); font-size: .87rem; line-height: 1.6; }
  .project-link { display: inline-flex; align-items: center; gap: 9px; margin-top: auto; color: #d8deeb; font-size: .84rem; font-weight: 600; transition: color .2s ease; }
  .project-link:hover { color: var(--cyan); }
  @media (max-width: 850px) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .projects-heading { align-items: flex-start; flex-direction: column; } .project-grid { grid-template-columns: 1fr; } .project-cover { height: 165px; } }
</style>
