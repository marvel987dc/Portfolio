<script>
  const menuButton = document.querySelector(".menu-toggle");
  const navigation = document.querySelector("#primary-navigation");
  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
    navigation?.classList.toggle("is-open", !isOpen);
  });
  navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Open navigation");
    navigation.classList.remove("is-open");
  }));
</script>
<style>
  .site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid rgba(255,255,255,.07); background: rgba(15,22,36,.82); backdrop-filter: blur(18px); }
  .nav-wrap { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { font-family: var(--font-display); font-size: 1.22rem; font-weight: 700; letter-spacing: -.04em; white-space: nowrap; }
  .brand span:first-child { color: var(--cyan); }
  .brand-dot { color: var(--violet); }
  .nav-links { display: flex; align-items: center; gap: clamp(16px, 2.5vw, 32px); }
  .nav-links > a:not(.social-mini) { color: var(--muted); font-size: .92rem; transition: color .2s ease; }
  .nav-links > a:hover { color: var(--text); }
  .nav-divider { width: 1px; height: 24px; background: var(--line); }
  .social-mini { width: 20px; height: 20px; display: inline-flex; color: var(--muted); }
  .social-mini:hover { color: var(--cyan); }
  .social-mini svg { width: 100%; fill: currentColor; }
  .menu-toggle { display: none; }
  @media (max-width: 700px) {
    .nav-wrap { min-height: 68px; }
    .menu-toggle { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 42px; height: 42px; border: 1px solid var(--line); border-radius: 50%; background: transparent; }
    .menu-toggle span { width: 16px; height: 1.5px; margin: 0 auto; background: var(--text); transition: transform .2s ease; }
    .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.25px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
    .nav-links { position: absolute; top: calc(100% + 1px); left: 0; right: 0; display: none; flex-direction: column; align-items: stretch; gap: 0; padding: 8px 24px 18px; background: rgba(15,22,36,.97); border-bottom: 1px solid var(--line); }
    .nav-links.is-open { display: flex; }
    .nav-links > a:not(.social-mini) { padding: 12px 0; }
    .nav-divider { width: 100%; height: 1px; margin: 6px 0 12px; }
    .social-mini { display: none; }
  }
</style>
