<section class="section contact-section" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy"><p class="eyebrow">Let’s talk</p><h2 class="section-title">Get in <span>touch.</span></h2><p class="section-copy">Have a question or want to work together? Feel free to send me a message! I’m always open to new opportunities and interesting conversations.</p>
      <div class="contact-direct"><a href="https://github.com/marvel987dc" target="_blank" rel="noopener noreferrer"><span class="contact-icon" aria-hidden="true">GH</span><span><small>Find me on</small><strong>GitHub</strong></span><span class="contact-arrow" aria-hidden="true">↗</span></a><a href="https://linkedin.com/in/juan-barrero-66b407290" target="_blank" rel="noopener noreferrer"><span class="contact-icon" aria-hidden="true">in</span><span><small>Connect on</small><strong>LinkedIn</strong></span><span class="contact-arrow" aria-hidden="true">↗</span></a></div>
    </div>
    <form class="contact-form" id="contact-form">
      <label for="user-name">Your name</label><input id="user-name" type="text" name="user_name" autocomplete="name" placeholder="Jane Smith" required />
      <label for="user-email">Your email</label><input id="user-email" type="email" name="user_email" autocomplete="email" placeholder="jane@example.com" required />
      <label for="user-subject">Subject</label><input id="user-subject" type="text" name="subject" placeholder="A quick hello" required />
      <label for="user-message">Message</label><textarea id="user-message" name="message" rows="4" placeholder="Tell me a little about what you have in mind…" required></textarea>
      <button class="button" type="submit"><span class="submit-label">Send message</span><span aria-hidden="true">↗</span></button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script>
  import emailjs from "@emailjs/browser";
  const form = document.querySelector("#contact-form");
  const status = document.querySelector("#form-status");
  const button = form?.querySelector("button[type=submit]");
  const label = form?.querySelector(".submit-label");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !button || !label || !(form instanceof HTMLFormElement)) return;
    button.disabled = true;
    label.textContent = "Sending…";
    status.textContent = "";
    status.dataset.state = "";
    try {
      await emailjs.sendForm("service_x7wnqnm", "template_rltw72t", form, "SSUSNZ9dSbs3i7ZDY");
      status.textContent = "Message sent successfully! I will get back to you soon.";
      status.dataset.state = "success";
      form.reset();
    } catch {
      status.textContent = "I couldn’t send that message. Please try again later.";
      status.dataset.state = "error";
    } finally {
      button.disabled = false;
      label.textContent = "Send message";
    }
  });
</script>
<style>
  .contact-section { border-top: 1px solid rgba(255,255,255,.055); background: radial-gradient(ellipse at 10% 86%, rgba(19,173,199,.06), transparent 33%), rgba(255,255,255,.012); }
  .contact-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(36px, 8vw, 100px); align-items: start; }
  .contact-copy .section-title { margin-bottom: 20px; }
  .contact-copy .section-copy { max-width: 420px; }
  .contact-direct { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .contact-direct a { display: flex; align-items: center; gap: 11px; min-width: 175px; border: 1px solid var(--line); border-radius: 13px; padding: 12px; background: rgba(255,255,255,.025); transition: border-color .2s ease; }
  .contact-direct a:hover { border-color: rgba(19,173,199,.38); }
  .contact-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: rgba(105,120,209,.15); color: #c0c8ff; font-size: .74rem; font-weight: 700; }
  .contact-direct small, .contact-direct strong { display: block; }
  .contact-direct small { margin-bottom: 3px; color: var(--muted); font-size: .68rem; }
  .contact-direct strong { font-size: .82rem; }
  .contact-arrow { margin-left: auto; color: #8f9db4; }
  .contact-form { display: grid; grid-template-columns: 1fr; gap: 9px; border: 1px solid var(--line); border-radius: 18px; padding: clamp(19px, 4vw, 30px); background: rgba(20,29,45,.8); box-shadow: 0 22px 60px rgba(0,0,0,.16); }
  .contact-form label { align-self: end; margin: 2px 0 3px; color: #cbd3e0; font-size: .78rem; }
  .contact-form input, .contact-form textarea { width: 100%; border: 1px solid rgba(223,232,255,.11); border-radius: 10px; padding: 12px 13px; outline: none; background: rgba(5,10,19,.38); color: var(--text); font-size: .88rem; transition: border-color .2s ease, background .2s ease; }
  .contact-form input:focus, .contact-form textarea:focus { border-color: rgba(19,173,199,.65); background: rgba(5,10,19,.58); }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: #6f7b8f; }
  .contact-form textarea { resize: vertical; min-height: 118px; }
  .contact-form button { justify-self: start; min-width: 165px; margin-top: 6px; cursor: pointer; }
  .contact-form button:disabled { opacity: .65; cursor: wait; }
  .form-status { min-height: 20px; margin: 0; color: var(--muted); font-size: .82rem; }
  .form-status[data-state="success"] { color: #77d8ae; }
  .form-status[data-state="error"] { color: #ff929b; }
  @media (max-width: 780px) { .contact-grid { grid-template-columns: 1fr; } .contact-copy .section-copy { max-width: 560px; } }
</style>
